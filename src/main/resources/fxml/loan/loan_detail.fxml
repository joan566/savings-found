<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.loan.controller.LoanDetailController"
      spacing="0"
      styleClass="application-page">

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS"
                styleClass="loan-detail-scroll">
        <content>
            <VBox spacing="16"
                  styleClass="loan-detail-page">

            <!-- Navegación -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="← Volver"
                        onAction="#handleBack"
                        styleClass="secondary-button"/>
            </HBox>

            <!-- Encabezado del préstamo -->
            <HBox spacing="16"
                  alignment="CENTER_LEFT">
                <styleClass>
                    <String fx:value="card"/>
                    <String fx:value="loan-page-header"/>
                </styleClass>

                <VBox spacing="5">
                    <Label fx:id="personLabel"
                           styleClass="page-title"/>

                    <Label fx:id="statusLabel"
                           style="-fx-font-weight: bold;"/>
                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button fx:id="registerPaymentButton"
                        text="Registrar pago"
                        onAction="#handleRegisterPayment"
                        styleClass="primary-button"/>
            </HBox>

            <!-- Resumen financiero -->
            <VBox spacing="12">
                <styleClass>
                    <String fx:value="card"/>
                    <String fx:value="loan-summary-panel"/>
                </styleClass>

                <Label text="Resumen del préstamo"
                       styleClass="section-heading"/>

                <HBox spacing="10" styleClass="loan-summary">

                    <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="loan-summary-card"/>
                            <String fx:value="loan-detail-metric-card"/>
                            <String fx:value="loan-summary-principal"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="principalIcon">
                                <styleClass>
                                    <String fx:value="loan-metric-icon"/>
                                    <String fx:value="loan-icon-blue"/>
                                </styleClass>
                            </Label>

                            <Label text="Monto prestado"
                                   styleClass="loan-metric-title"
                                   wrapText="true"
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"/>
                        </HBox>

                        <Label fx:id="principalLabel">
                            <styleClass>
                                <String fx:value="metric-value"/>
                                <String fx:value="loan-metric-value"/>
                            </styleClass>
                        </Label>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="loan-summary-card"/>
                            <String fx:value="loan-detail-metric-card"/>
                            <String fx:value="loan-summary-rate"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="rateIcon">
                                <styleClass>
                                    <String fx:value="loan-metric-icon"/>
                                    <String fx:value="loan-icon-purple"/>
                                </styleClass>
                            </Label>

                            <Label text="Tasa de interés"
                                   styleClass="loan-metric-title"
                                   wrapText="true"
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"/>
                        </HBox>

                        <Label fx:id="rateLabel">
                            <styleClass>
                                <String fx:value="metric-value"/>
                                <String fx:value="loan-metric-value"/>
                            </styleClass>
                        </Label>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="loan-summary-card"/>
                            <String fx:value="loan-detail-metric-card"/>
                            <String fx:value="loan-summary-balance"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="balanceIcon">
                                <styleClass>
                                    <String fx:value="loan-metric-icon"/>
                                    <String fx:value="loan-icon-orange"/>
                                </styleClass>
                            </Label>

                            <Label text="Saldo de capital"
                                   styleClass="loan-metric-title"
                                   wrapText="true"
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"/>
                        </HBox>

                        <Label fx:id="principalBalanceLabel">
                            <styleClass>
                                <String fx:value="metric-value"/>
                                <String fx:value="loan-metric-value"/>
                                <String fx:value="value-expense"/>
                            </styleClass>
                        </Label>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="loan-summary-card"/>
                            <String fx:value="loan-detail-metric-card"/>
                            <String fx:value="loan-summary-interest"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="interestIcon">
                                <styleClass>
                                    <String fx:value="loan-metric-icon"/>
                                    <String fx:value="loan-icon-red"/>
                                </styleClass>
                            </Label>

                            <Label text="Interés pendiente"
                                   styleClass="loan-metric-title"
                                   wrapText="true"
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"/>
                        </HBox>

                        <Label fx:id="interestOwedLabel">
                            <styleClass>
                                <String fx:value="metric-value"/>
                                <String fx:value="loan-metric-value"/>
                                <String fx:value="value-expense"/>
                            </styleClass>
                        </Label>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="loan-summary-card"/>
                            <String fx:value="loan-detail-metric-card"/>
                            <String fx:value="loan-summary-paid"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="paidIcon">
                                <styleClass>
                                    <String fx:value="loan-metric-icon"/>
                                    <String fx:value="loan-icon-green"/>
                                </styleClass>
                            </Label>

                            <Label text="Pagado (histórico)"
                                   styleClass="loan-metric-title"
                                   wrapText="true"
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"/>
                        </HBox>

                        <Label fx:id="paidLabel">
                            <styleClass>
                                <String fx:value="metric-value"/>
                                <String fx:value="loan-metric-value"/>
                                <String fx:value="value-income"/>
                            </styleClass>
                        </Label>
                    </VBox>

                </HBox>
            </VBox>

            <!-- Información complementaria -->
            <HBox spacing="16"
                  styleClass="loan-detail-meta">

                <VBox spacing="8"
                      HBox.hgrow="ALWAYS">
                    <styleClass>
                        <String fx:value="card"/>
                        <String fx:value="loan-meta-card"/>
                    </styleClass>

                    <Label text="Fecha del préstamo"
                           styleClass="metric-label"/>

                    <Label fx:id="dateLabel"
                           styleClass="loan-meta-value"/>
                </VBox>

                <VBox spacing="8"
                      HBox.hgrow="ALWAYS">
                    <styleClass>
                        <String fx:value="card"/>
                        <String fx:value="loan-meta-card"/>
                    </styleClass>

                    <Label text="Observación"
                           styleClass="metric-label"/>

                    <Label fx:id="notesLabel"
                           styleClass="loan-meta-value"/>
                </VBox>

            </HBox>

            <!-- Historial de movimientos -->
            <VBox spacing="16"
                  VBox.vgrow="ALWAYS">
                <styleClass>
                    <String fx:value="card"/>
                    <String fx:value="loan-history-panel"/>
                </styleClass>

                <!-- Encabezado -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">

                        <Label text="Movimientos del préstamo"
                               styleClass="section-heading"/>

                        <Label text="Consulta los pagos y cobros asociados a este préstamo."
                               styleClass="section-description"/>

                    </VBox>
                </HBox>

                <!-- Filtros -->
                <HBox spacing="8"
                      alignment="CENTER_LEFT"
                      styleClass="loan-filter-bar">

                    <ToggleButton fx:id="allToggle"
                                  text="Todos"
                                  styleClass="secondary-button"/>

                    <ToggleButton fx:id="paymentsToggle"
                                  text="Pagos"
                                  styleClass="secondary-button"/>

                    <ToggleButton fx:id="chargesToggle"
                                  text="Cobros"
                                  styleClass="secondary-button"/>

                    <ToggleButton fx:id="pendingToggle"
                                  text="Pendientes"
                                  styleClass="secondary-button"/>

                </HBox>

                <!-- Tabla -->
                <TableView fx:id="timelineTable"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>

                    <columns>

                        <TableColumn fx:id="timelineDateColumn"
                                     text="Fecha"
                                     prefWidth="100"/>

                        <TableColumn fx:id="timelineTypeColumn"
                                     text="Tipo"
                                     prefWidth="90"/>

                        <TableColumn fx:id="timelineDetailColumn"
                                     text="Detalle"
                                     prefWidth="280"/>

                        <TableColumn fx:id="timelineAmountColumn"
                                     text="Monto"
                                     prefWidth="120"
                                     styleClass="loan-centered-amount"/>

                        <TableColumn fx:id="timelineStatusColumn"
                                     text="Estado"
                                     prefWidth="110"/>

                    </columns>
                </TableView>

            </VBox>

            </VBox>
        </content>
    </ScrollPane>
</VBox>

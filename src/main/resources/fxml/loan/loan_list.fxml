<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.loan.controller.LoanListController"
spacing="16">
    <styleClass>
  <String fx:value="application-page"/>
  <String fx:value="loan-page"/>
    </styleClass>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="page-header">
        <VBox spacing="2">
            <Label text="Préstamos" styleClass="page-title"/>
            <Label text="Administra los préstamos y consulta los saldos pendientes." styleClass="page-subtitle"/>
        </VBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Nuevo préstamo" onAction="#handleNewLoan" styleClass="primary-button"/>
    </HBox>

    <HBox spacing="12" styleClass="loan-metrics">
        <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <styleClass>
                <String fx:value="card"/>
                <String fx:value="loan-summary-card"/>
                <String fx:value="loan-summary-principal"/>
            </styleClass>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="loanedMoneyIcon">
                    <styleClass>
                        <String fx:value="loan-metric-icon"/>
                        <String fx:value="loan-icon-blue"/>
                    </styleClass>
                </Label>
                <Label text="Dinero prestado" styleClass="loan-metric-title"/>
            </HBox>
            <Label fx:id="loanedMoneyLabel">
                <styleClass>
                    <String fx:value="metric-value"/>
                    <String fx:value="loan-metric-value"/>
                </styleClass>
            </Label>
        </VBox>

        <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <styleClass>
                <String fx:value="card"/>
                <String fx:value="loan-summary-card"/>
                <String fx:value="loan-summary-interest"/>
            </styleClass>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="outstandingDebtIcon">
                    <styleClass>
                        <String fx:value="loan-metric-icon"/>
                        <String fx:value="loan-icon-red"/>
                    </styleClass>
                </Label>
                <Label text="Deuda pendiente" styleClass="loan-metric-title"/>
            </HBox>
            <Label fx:id="outstandingDebtLabel">
                <styleClass>
                    <String fx:value="metric-value"/>
                    <String fx:value="loan-metric-value"/>
                    <String fx:value="value-expense"/>
                </styleClass>
            </Label>
        </VBox>

        <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <styleClass>
                <String fx:value="card"/>
                <String fx:value="loan-summary-card"/>
                <String fx:value="loan-summary-paid"/>
            </styleClass>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="activeLoanCountIcon">
                    <styleClass>
                        <String fx:value="loan-metric-icon"/>
                        <String fx:value="loan-icon-green"/>
                    </styleClass>
                </Label>
                <Label text="Préstamos activos" styleClass="loan-metric-title"/>
            </HBox>
            <Label fx:id="activeLoanCountLabel">
                <styleClass>
                    <String fx:value="metric-value"/>
                    <String fx:value="loan-metric-value"/>
                </styleClass>
            </Label>
        </VBox>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="loan-filter-bar">
        <ToggleButton fx:id="activeToggle" text="Activos" styleClass="secondary-button"/>
        <ToggleButton fx:id="paidToggle" text="Pagados" styleClass="secondary-button"/>
        <ToggleButton fx:id="allToggle" text="Todos" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="clickable-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="personColumn" text="Persona" prefWidth="180"/>
            <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="100"/>
            <TableColumn fx:id="amountColumn" text="Monto" prefWidth="110" styleClass="money-column"/>
            <TableColumn fx:id="totalColumn" text="Saldo capital" prefWidth="120" styleClass="money-column"/>
            <TableColumn fx:id="paidColumn" text="Pagado" prefWidth="110" styleClass="money-column"/>
            <TableColumn fx:id="outstandingColumn" text="Pendiente" prefWidth="110" styleClass="money-column"/>
            <TableColumn fx:id="statusColumn" text="Estado" prefWidth="90"/>
        </columns>
    </TableView>
</VBox>

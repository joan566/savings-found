<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.dashboard.controller.DashboardController"
      spacing="14"
      styleClass="dashboard">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label fx:id="greetingLabel" styleClass="page-title"/>
            <Label text="Aquí tienes un resumen del estado de tu fondo." styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="dashboard-scroll">
        <VBox spacing="14">
            <padding>
                <Insets top="2" right="2" bottom="12" left="2"/>
            </padding>

            <HBox spacing="12">
                <VBox fx:id="savingsCard" styleClass="dashboard-summary-card" spacing="7" prefWidth="170" minWidth="150"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="9">
                        <Label fx:id="savingsIcon" styleClass="summary-icon-bubble"/>
                        <Label fx:id="savingsHeaderLabel" text="Fondo de ahorro" styleClass="summary-title"/>
                    </HBox>
                    <Label fx:id="savingsTotalLabel" styleClass="metric-hero"/>
                    <HBox spacing="16">
                        <VBox spacing="2">
                            <Label text="Efectivo" styleClass="metric-label"/>
                            <Label fx:id="savingsCashLabel" styleClass="summary-detail"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="Transferencia" styleClass="metric-label"/>
                            <Label fx:id="savingsTransferLabel" styleClass="summary-detail"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox fx:id="birthdayCard" styleClass="dashboard-summary-card" spacing="7" prefWidth="170" minWidth="150"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="9">
                        <Label fx:id="birthdayIcon" styleClass="summary-icon-bubble"/>
                        <Label fx:id="birthdayHeaderLabel" text="Fondo de cumpleaños" styleClass="summary-title"/>
                    </HBox>
                    <Label fx:id="birthdayTotalLabel" styleClass="metric-hero"/>
                    <HBox spacing="16">
                        <VBox spacing="2">
                            <Label text="Efectivo" styleClass="metric-label"/>
                            <Label fx:id="birthdayCashLabel" styleClass="summary-detail"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="Transferencia" styleClass="metric-label"/>
                            <Label fx:id="birthdayTransferLabel" styleClass="summary-detail"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox fx:id="loansCard" styleClass="dashboard-summary-card" spacing="7" prefWidth="205" minWidth="190"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="9">
                        <Label fx:id="loansIcon" styleClass="summary-icon-bubble"/>
                        <Label fx:id="loansHeaderLabel" text="Préstamos" styleClass="summary-title"/>
                    </HBox>
                    <HBox spacing="10">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Dinero prestado" styleClass="metric-label" wrapText="true"/>
                            <Label fx:id="loanedMoneyLabel" styleClass="summary-detail-strong"/>
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Deuda pendiente" styleClass="metric-label" wrapText="true"/>
                            <Label fx:id="outstandingDebtLabel" styleClass="summary-detail-strong"/>
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Préstamos activos" styleClass="metric-label" wrapText="true"/>
                            <Label fx:id="activeLoanCountLabel" styleClass="summary-detail-strong"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox fx:id="peopleCard" styleClass="dashboard-summary-card" spacing="7" prefWidth="160" minWidth="150"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="9">
                        <Label fx:id="peopleIcon" styleClass="summary-icon-bubble"/>
                        <Label fx:id="personsHeaderLabel" text="Participantes" styleClass="summary-title"/>
                    </HBox>
                    <Label fx:id="personCountLabel" styleClass="metric-value"/>
                    <Label text="Total de personas activas" styleClass="metric-label"/>
                </VBox>
            </HBox>

            <HBox spacing="12" VBox.vgrow="ALWAYS">
                <VBox styleClass="dashboard-panel" spacing="10" HBox.hgrow="ALWAYS" minWidth="340">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Resumen general" styleClass="section-title"/>
                            <Label text="Ingresos mensuales por fondo" styleClass="page-subtitle"/>
                        </VBox>
                        <ComboBox fx:id="periodSelector" styleClass="period-selector"/>
                    </HBox>
                    <LineChart fx:id="incomeChart" VBox.vgrow="ALWAYS" minHeight="190" prefHeight="220"
                               styleClass="income-chart" createSymbols="true" legendVisible="true">
                        <xAxis>
                            <CategoryAxis side="BOTTOM" animated="false"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="chartYAxis" side="LEFT" forceZeroInRange="true" animated="false"
                                        minorTickVisible="false"/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <VBox styleClass="dashboard-panel" spacing="10" prefWidth="300" minWidth="260"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <VBox spacing="2">
                        <Label text="Accesos rápidos" styleClass="section-title"/>
                        <Label text="Realiza tus tareas fácilmente" styleClass="page-subtitle"/>
                    </VBox>
                    <GridPane hgap="8" vgap="8" VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Button fx:id="peopleQuickLink" text="Gestionar&#10;personas" onAction="#openPeople" contentDisplay="TOP"
                                styleClass="quick-link" maxWidth="Infinity" maxHeight="Infinity"
                                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Button fx:id="movementQuickLink" text="Registrar&#10;movimiento" onAction="#openMovements"
                                contentDisplay="TOP" styleClass="quick-link" maxWidth="Infinity"
                                maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button fx:id="loansQuickLink" text="Gestionar&#10;préstamos" onAction="#openLoans"
                                contentDisplay="TOP" styleClass="quick-link" maxWidth="Infinity"
                                maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Button fx:id="birthdaysQuickLink" text="Cumpleaños" onAction="#openBirthdays"
                                contentDisplay="TOP" styleClass="quick-link" maxWidth="Infinity"
                                maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Button fx:id="settlementsQuickLink" text="Liquidaciones" onAction="#openSettlements"
                                contentDisplay="TOP" styleClass="quick-link" maxWidth="Infinity"
                                maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Button fx:id="settingsQuickLink" text="Configuración" onAction="#openSettings"
                                contentDisplay="TOP" styleClass="quick-link" maxWidth="Infinity"
                                maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <VBox styleClass="dashboard-panel" spacing="10" HBox.hgrow="ALWAYS" minHeight="105">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="birthdaysHeaderLabel" text="Próximos cumpleaños" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Button text="Ver todos →" onAction="#openBirthdays" styleClass="dashboard-link-button"/>
                    </HBox>
                    <VBox fx:id="birthdaysContainer" spacing="10"/>
                </VBox>
                <VBox styleClass="dashboard-panel" spacing="10" HBox.hgrow="ALWAYS" minHeight="105">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="activityHeaderLabel" text="Actividad reciente" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Button text="Ver todo →" onAction="#openMovements" styleClass="dashboard-link-button"/>
                    </HBox>
                    <VBox fx:id="activityContainer" spacing="4"/>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
